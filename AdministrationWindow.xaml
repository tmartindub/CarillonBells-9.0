<Window FontSize="18" FontFamily="Bahnschrift" Language="en-US" x:Class="Carillon.AdministrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Carillon"
 Title="Carillon Administration" Width="1320" Height="840" MinWidth="1100" MinHeight="620" Background="{DynamicResource Canvas}" WindowStartupLocation="CenterOwner" Closing="WindowClosing" Icon="images and icons/Carillon.ico">
 <DockPanel Margin="22">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="Carillon administration" FontFamily="Georgia" FontSize="32"/><TextBlock Text="Changes remain pending until Save" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><TextBlock x:Name="ResultLabel" VerticalAlignment="Center" Margin="0,0,15,0"/><Button Content="Cancel changes" Click="CancelClick" Margin="0,0,8,0"/><Button Content="Save" Click="SaveClick" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button Content="Close" Click="CloseClick"/></StackPanel>
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Tag,ElementName=Pages}" Value="Groups"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SelectedItem.Tag,ElementName=Pages}" Value="Random"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding SelectedItem.Tag,ElementName=Pages}" Value="Silence"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button Content="First" Tag="First" Click="NavigateClick"/><Button Content="Previous" Tag="Previous" Click="NavigateClick" Margin="6,0"/><Button Content="Next" Tag="Next" Click="NavigateClick"/><Button Content="Last" Tag="Last" Click="NavigateClick" Margin="6,0"/><StackPanel Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Tag,ElementName=Pages}" Value="Groups"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="Add group" Click="AddGroupClick" Margin="15,0,6,0"/><Button Content="Delete group" Click="DeleteGroupClick"/></StackPanel></WrapPanel>
  <TabControl x:Name="Pages" SelectionChanged="PageChanged" Background="{DynamicResource Surface}">
   <TabItem Header="Groups" Tag="Groups"><DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="Recalculate dates for upcoming year" Click="RecalculateGroupsClick"/><TextBlock Text="Custom group names and dates are preserved." VerticalAlignment="Center" Margin="15,0"/></StackPanel>
    <DataGrid x:Name="GroupsGrid" ItemsSource="{Binding Groups.DefaultView}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"><DataGrid.Columns><DataGridTextColumn Header="Group" Binding="{Binding [SEASONALGROUP]}" Width="*"/><DataGridTextColumn Header="From (MM/dd/yyyy)" Binding="{Binding [PLAY_DATE_FROM]}" Width="220"/><DataGridTextColumn Header="Until (MM/dd/yyyy)" Binding="{Binding [PLAY_DATE_TO]}" Width="220"/><DataGridTextColumn Header="Play time" Binding="{Binding [PLAY_TIME]}" Width="140"/></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="System" Tag="System"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SystemFieldsPanel" Margin="22"><TextBlock Text="Organization name" Margin="0,9,0,4"/><TextBox Text="{Binding [ORGANIZATION_NAME], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Fallback random directory (legacy)" Margin="0,9,0,4"/><TextBox Text="{Binding [RAND_SONGS_DIRECTORY], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Playback logging" Margin="0,9,0,4"/><CheckBox IsChecked="{Binding [LOGGING_STATUS], Converter={StaticResource IntBool}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Enable liturgical and funeral silence" Margin="0,9,0,4"/><CheckBox IsChecked="{Binding [silence_enabled], Converter={StaticResource IntBool}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Ash Wednesday (MM/dd/yyyy)" Margin="0,9,0,4"/><TextBox Text="{Binding [ash_wed_begin], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Ash Wednesday end (legacy compatibility)" Margin="0,9,0,4"/><TextBox Text="{Binding [ash_wed_end], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Holy Thursday (MM/dd/yyyy)" Margin="0,9,0,4"/><TextBox Text="{Binding [holy_thu_begin], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Holy Saturday (MM/dd/yyyy)" Margin="0,9,0,4"/><TextBox Text="{Binding [holy_sat_end], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="All Souls Day (MM/dd/yyyy)" Margin="0,9,0,4"/><TextBox Text="{Binding [all_souls_day], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Funeral begin date (optional)" Margin="0,9,0,4"/><TextBox Text="{Binding [other_silence_begin_date], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Funeral begin time" Margin="0,9,0,4"/><TextBox Text="{Binding [other_silence_begin_time], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Funeral end date (optional)" Margin="0,9,0,4"/><TextBox Text="{Binding [other_silence_end_date], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Funeral end time" Margin="0,9,0,4"/><TextBox Text="{Binding [other_silence_end_time], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><WrapPanel Margin="0,16"><Button Content="Recalculate Easter / All Souls" Click="RecalculateSettingsClick"/><Button Content="Clear funeral dates" Click="ClearFuneralClick" Margin="12,0"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Email / reports" Tag="Email"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
    <StackPanel x:Name="EmailFieldsPanel"><TextBlock Text="Enable email" Margin="0,9,0,4"/><CheckBox IsChecked="{Binding [email_enabled], Converter={StaticResource IntBool}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="SMTP host" Margin="0,9,0,4"/><TextBox Text="{Binding [smtp_host], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="SMTP port (STARTTLS)" Margin="0,9,0,4"/><TextBox Text="{Binding [smtp_port], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Username" Margin="0,9,0,4"/><TextBox Text="{Binding [email_user], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="From address" Margin="0,9,0,4"/><TextBox Text="{Binding [from_address], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Alert recipients" Margin="0,9,0,4"/><TextBox Text="{Binding [email_recipients], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Test recipient" Margin="0,9,0,4"/><TextBox Text="{Binding [test_recipient], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/><TextBlock Text="Morning report recipients" Margin="0,9,0,4"/><TextBox Text="{Binding [morning_report_recipients], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="700" HorizontalAlignment="Left" Width="700"/></StackPanel>
    <TextBlock Text="Password / app password" Margin="0,10,0,5"/><PasswordBox x:Name="EmailPassword" Padding="8" MaxWidth="600" HorizontalAlignment="Left" Width="600"/>
    <TextBox x:Name="VisiblePassword" Visibility="Collapsed" MaxWidth="600" HorizontalAlignment="Left" Width="600"/>
    <CheckBox x:Name="ShowPassword" Content="Show password" Click="ShowPasswordClick" Margin="0,10"/>
    <WrapPanel Margin="0,14"><Button Content="Send test message" Click="TestEmailClick" Margin="0,0,10,0"/><Button Content="Test morning report" Click="TestMorningClick" Margin="0,0,10,0"/><Button Content="Preview report" Click="PreviewReportClick"/></WrapPanel>
    <TextBlock Text="SMTP uses explicit STARTTLS. Test sends require confirmation. Evaluation mode suppresses automatic email." TextWrapping="Wrap"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Random music" Tag="Random"><DockPanel Margin="18"><StackPanel DockPanel.Dock="Top" Margin="0,0,0,12"><TextBlock Text="Slot 1 is the fallback. Slots 2–7 are annual date overrides; the first matching slot wins." TextWrapping="Wrap"/><Button Content="Browse for selected directory" Click="BrowseRandomClick" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
    <DataGrid x:Name="RandomGrid" ItemsSource="{Binding RandomDirectories.DefaultView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"><DataGrid.Columns><DataGridTextColumn Header="Slot" Binding="{Binding [slot_no]}" Width="75" IsReadOnly="True"/><DataGridTextColumn Header="Music directory" Binding="{Binding [rand_music_dir]}" Width="*"/><DataGridTextColumn Header="From (annual)" Binding="{Binding [frm_date]}" Width="190"/><DataGridTextColumn Header="Until (annual)" Binding="{Binding [to_date]}" Width="190"/></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="Silence windows" Tag="Silence"><DockPanel Margin="18"><TextBlock DockPanel.Dock="Top" Text="Twelve reusable rules. Overnight rules use the starting weekday. Equal start/end is inactive. Purpose appears in logs." TextWrapping="Wrap" Margin="0,0,0,12"/>
    <DataGrid x:Name="SilenceGrid" ItemsSource="{Binding Silence.DefaultView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"><DataGrid.Columns>
     <DataGridTextColumn Header="ID" Binding="{Binding [silence_id]}" IsReadOnly="True" Width="60"/><DataGridCheckBoxColumn Header="On" Binding="{Binding [enabled], Converter={StaticResource IntBool}}" Width="60"/>
     <DataGridTextColumn Header="Purpose" Binding="{Binding [Purpose]}" Width="*"/><DataGridTextColumn Header="Start" Binding="{Binding [start_time]}" Width="130"/><DataGridTextColumn Header="End" Binding="{Binding [end_time]}" Width="130"/>
     <DataGridCheckBoxColumn Header="Mon" Binding="{Binding [monday], Converter={StaticResource IntBool}}" Width="66"/><DataGridCheckBoxColumn Header="Tue" Binding="{Binding [tuesday], Converter={StaticResource IntBool}}" Width="66"/><DataGridCheckBoxColumn Header="Wed" Binding="{Binding [wednesday], Converter={StaticResource IntBool}}" Width="66"/><DataGridCheckBoxColumn Header="Thu" Binding="{Binding [thursday], Converter={StaticResource IntBool}}" Width="66"/><DataGridCheckBoxColumn Header="Fri" Binding="{Binding [friday], Converter={StaticResource IntBool}}" Width="66"/><DataGridCheckBoxColumn Header="Sat" Binding="{Binding [saturday], Converter={StaticResource IntBool}}" Width="66"/><DataGridCheckBoxColumn Header="Sun" Binding="{Binding [sunday], Converter={StaticResource IntBool}}" Width="66"/>
    </DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="Themes" Tag="Themes"><StackPanel Margin="22"><TextBlock Text="Color palette" FontSize="22"/><ComboBox x:Name="ThemeList" ItemsSource="{StaticResource ThemeCatalog}" Style="{StaticResource PalettePicker}" SelectionChanged="ThemeChanged" Width="330" HorizontalAlignment="Left" Margin="0,15"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" Padding="8,5"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Custom background / text colors (#RRGGBB)"/><StackPanel Orientation="Horizontal" Margin="0,10"><TextBox x:Name="CustomBackground" Text="#EFF3F6" Width="190"/><TextBox x:Name="CustomText" Text="#173650" Width="190" Margin="10,0"/><Button Content="Apply and save custom colors" Click="CustomThemeClick"/></StackPanel><TextBlock Text="Palette changes apply immediately to every window and are saved separately."/></StackPanel></TabItem>
   <TabItem Header="Database" Tag="Database"><StackPanel Margin="24"><TextBlock Text="Import a database into this separate application" FontFamily="Georgia" FontSize="25"/><TextBlock Text="The selected source database is opened read-only and copied with SQLite backup. The current local database receives a ZIP backup first. The source is never upgraded or written. Close other Carillon instances using that database before import." TextWrapping="Wrap" Margin="0,15"/><WrapPanel><Button Content="Analyze source database" Click="AnalyzeDatabaseClick" Margin="0,0,10,0"/><Button Content="Choose and import a database copy" Click="ImportClick" Margin="0,0,10,0"/><Button Content="Save report" Click="SaveMigrationReportClick"/></WrapPanel><TextBlock x:Name="DatabaseLabel" TextWrapping="Wrap" Margin="0,20"/><TextBox x:Name="MigrationReport" IsReadOnly="True" AcceptsReturn="True" Height="260" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
