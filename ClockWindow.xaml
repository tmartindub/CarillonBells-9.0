<Window FontSize="{DynamicResource UiFontSize18}" FontFamily="{DynamicResource BodyFontFamily}" Language="en-US" x:Class="Carillon.ClockWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Westminster Chimes and Carillon Bells v9.0 - Clock" Width="1200" Height="750" WindowState="Maximized" Background="#A72A29" Icon="images and icons/Carillon-Bells-9.0-icon.ico" Closed="ClockClosed">
 <DockPanel>
  <Menu DockPanel.Dock="Top"><MenuItem Header="_File"><MenuItem Header="_Close" Click="CloseClick"/></MenuItem></Menu>
  <Viewbox Stretch="Uniform"><Canvas Width="1680" Height="864">
   <Image Source="images and icons/ClockFace.png" Width="1680" Height="864"/>
   <Canvas Canvas.Left="610" Canvas.Top="200" Width="460" Height="460" DataContext="{DynamicResource SelectedClockHands}">
    <Canvas.Style><Style TargetType="Canvas"><Setter Property="DataContext" Value="{StaticResource OriginalClockHands}"/></Style></Canvas.Style>
    <Rectangle Width="460" Height="460" Fill="{Binding Minute}">
     <Rectangle.RenderTransform><RotateTransform x:Name="MinuteRotation" CenterX="230" CenterY="230"/></Rectangle.RenderTransform>
    </Rectangle>
    <Rectangle Width="460" Height="460" Fill="{Binding Hour}">
     <Rectangle.RenderTransform><RotateTransform x:Name="HourRotation" CenterX="230" CenterY="230"/></Rectangle.RenderTransform>
    </Rectangle>
    <Rectangle Width="460" Height="460" Fill="{Binding Cap}"/>
   </Canvas>
  </Canvas></Viewbox>
 </DockPanel>
</Window>
