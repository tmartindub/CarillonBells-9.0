<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CarillonBells</AssemblyName><RootNamespace>Carillon</RootNamespace>
    <Version>9.0.0</Version><ApplicationIcon>images and icons\Carillon-Bells-9.0-icon.ico</ApplicationIcon>
    <OutputPath>bin\$(Configuration)\</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CarillonSingleExe)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>None</DebugType>
    <DefineConstants>$(DefineConstants);CARILLON_SINGLE_EXE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <Resource Include="images and icons\ClockFace.png" />
    <Resource Include="images and icons\Splash.png" />
    <Resource Include="images and icons\Carillon-Bells-9.0-icon.ico" />
    <Resource Include="samples\empty-schema.sql" />
    <Compile Remove="tools\**\*.cs" />
    <Page Remove="tools\CarillonMigration\**\*.xaml" />
    <Compile Include="tools\CarillonMigration\MigrationEngine.cs;tools\CarillonMigration\MigrationWindow.xaml.cs;tools\CarillonMigration\UsbUpgrade.cs" />
    <Page Include="tools\CarillonMigration\MigrationWindow.xaml;tools\CarillonMigration\MigrationStyles.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(CarillonSingleExe)' != 'true'">
    <Content Include="help\**\*;LICENSE;NOTICE;third-party-notices\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(CarillonSingleExe)' == 'true'">
    <EmbeddedResource Include="help\**\*" LogicalName="Carillon.Help/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="LICENSE;NOTICE;third-party-notices\**\*" LogicalName="Carillon.Notices/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
