<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CarillonBells</AssemblyName><RootNamespace>Carillon</RootNamespace>
    <Version>9.0.0</Version><ApplicationIcon>images and icons\Carillon.ico</ApplicationIcon>
    <OutputPath>bin\$(Configuration)\</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NLayer.NAudioSupport" Version="2.0.1" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <Resource Include="images and icons\ClockFace.png" />
    <Resource Include="images and icons\Splash.png" />
    <Resource Include="images and icons\Carillon.ico" />
    <Resource Include="samples\empty-schema.sql" />
    <Content Include="help\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NOTICE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="third-party-notices\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tools\**\*.cs" />
  </ItemGroup>
</Project>
