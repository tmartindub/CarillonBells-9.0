<Window x:Class="Carillon.Migration.MigrationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Westminster Chimes and Carillon Bells v9.0 - Migration Assistant" Width="930" Height="730" MinWidth="650" MinHeight="480"
 WindowStartupLocation="CenterScreen" FontFamily="Bahnschrift" FontSize="16" Language="en-US"
 Closing="WindowClosing">
 <Window.Resources>
  <ResourceDictionary Source="/CarillonBells;component/tools/CarillonMigration/MigrationStyles.xaml"/>
 </Window.Resources>
 <Window.Background><StaticResource ResourceKey="Canvas"/></Window.Background>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Background="{StaticResource Ink}" Padding="28,18">
   <StackPanel>
    <TextBlock Text="Westminster Chimes and Carillon Bells" FontSize="29" FontFamily="Georgia" Foreground="White"/>
    <TextBlock Text="Migration Assistant · v9.0" FontSize="17" Foreground="White" Margin="0,4,0,0"/>
    <TextBlock Foreground="#E0EAF2" FontSize="15" Margin="0,6,0,0">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
       <Setter Property="Text" Value="Copy a Carillon 7.2.4 or 8.1 installation into a new v9 folder."/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
         <Setter Property="Text" Value="Upgrade a Carillon 7.2.4 or 8.1 installation on its existing USB drive."/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRestoreMode}" Value="True">
         <Setter Property="Text" Value="Return a USB installation to Carillon 7.2.4 using its pre-upgrade backup."/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <Border.Style>
    <Style TargetType="Border">
     <Style.Triggers>
      <DataTrigger Binding="{Binding IsRestoreMode}" Value="True">
       <Setter Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </Border.Style>
   <UniformGrid Columns="4" Margin="24,8">
    <TextBlock Text="Source">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource StepText}">
       <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentStep}" Value="0">
         <Setter Property="Background" Value="{StaticResource ActiveStep}"/>
         <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <TextBlock>
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource StepText}">
       <Setter Property="Text" Value="Destination"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
         <Setter Property="Text" Value="Backup"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding CurrentStep}" Value="1">
         <Setter Property="Background" Value="{StaticResource ActiveStep}"/>
         <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <TextBlock Text="Review">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource StepText}">
       <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
         <Setter Property="Background" Value="{StaticResource ActiveStep}"/>
         <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <TextBlock Text="Result">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource StepText}">
       <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentStep}" Value="3">
         <Setter Property="Background" Value="{StaticResource ActiveStep}"/>
         <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </UniformGrid>
  </Border>
  <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
   PanningMode="VerticalOnly" IsEnabled="{Binding CanNavigate}">
   <Border Margin="24,18" Padding="24" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
    <Grid>
      <StackPanel AutomationProperties.Name="Source step">
       <StackPanel.Style>
        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPage}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="0">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock Style="{StaticResource PageTitle}" Text="Choose the legacy installation"/>
       <TextBlock>
        <TextBlock.Style>
         <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Setter Property="Text" Value="Select the folder that contains the older Carillon installation and its databases folder. This can be the root of an older portable drive."/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
            <Setter Property="Text" Value="On the USB you want to upgrade, select the folder that contains the older Carillon installation and its databases folder. Select the drive itself if Carillon is at its root."/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <Label Margin="0,20,0,0" Content="Legacy installation _folder" Target="{Binding ElementName=SourceInput}"/>
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SourceInput" AutomationProperties.Name="Legacy installation folder"
         AutomationProperties.HelpText="Enter the full folder path or choose Browse."/>
        <Button Grid.Column="1" Margin="10,0,0,0" Content="_Browse…" AutomationProperties.Name="Browse for legacy installation"
         Click="BrowseSourceClick"/>
       </Grid>
       <TextBlock Style="{StaticResource FieldHint}" Margin="0,10,0,0"
        Text="Next identifies the version and playlist count from the local database."/>
       <Border Margin="0,24,0,0" Padding="14,12" Background="{StaticResource ActiveStep}" CornerRadius="6">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Return to Carillon 7.2.4" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource FieldHint}" Text="Restore the original database from a pre-upgrade backup."/>
         </StackPanel>
         <Button Grid.Column="1" Content="_Restore 7.2.4…" Margin="14,0,0,0" VerticalAlignment="Center"
          Click="OpenRestoreClick"/>
        </Grid>
       </Border>
      </StackPanel>
      <StackPanel>
       <StackPanel.Style>
        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPage}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="1">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock>
        <TextBlock.Style>
         <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
          <Setter Property="Text" Value="Choose a new v9 folder"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
            <Setter Property="Text" Value="Choose a backup folder"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <TextBlock x:Name="InspectedSource" FontWeight="SemiBold"/>
       <StackPanel AutomationProperties.Name="Destination step">
        <StackPanel.Style>
         <Style TargetType="StackPanel">
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
            <Setter Property="Visibility" Value="Collapsed"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </StackPanel.Style>
        <Label Margin="0,20,0,0" Content="_New installation path" Target="{Binding ElementName=DestinationInput}"/>
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <TextBox x:Name="DestinationInput" Text="CarillonBells_9_0" AutomationProperties.Name="New installation path"
          AutomationProperties.HelpText="Enter the full path for a new folder, or browse for its parent."/>
         <Button Grid.Column="1" Margin="10,0,0,0" Content="Browse _parent…" AutomationProperties.Name="Browse for parent of new installation"
          Click="BrowseDestinationClick"/>
        </Grid>
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,10,0,0"
         Text="Choose an existing parent folder and use the suggested name, or enter a full path such as E:\CarillonBells_9_0. The final folder must be new."/>
       </StackPanel>
       <StackPanel AutomationProperties.Name="Backup step" Visibility="{Binding IsUsbUpgrade, Converter={StaticResource VisibleWhenTrue}}">
        <Label Margin="0,20,0,0" Content="_Backup folder" Target="{Binding ElementName=BackupFolderInput}"/>
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <TextBox x:Name="BackupFolderInput" AutomationProperties.Name="Backup folder"
          AutomationProperties.HelpText="Enter a full folder path on your PC or another drive, or choose Browse."/>
         <Button Grid.Column="1" Margin="10,0,0,0" Content="B_rowse…" AutomationProperties.Name="Browse for the backup folder"
          Click="BrowseBackupClick"/>
        </Grid>
        <TextBlock Style="{StaticResource FieldHint}" Margin="0,10,0,0"
         Text="Use a folder on your PC or another drive. The assistant creates and verifies a ZIP backup before making changes to the selected USB."/>
       </StackPanel>
      </StackPanel>
      <StackPanel AutomationProperties.Name="Review step">
       <StackPanel.Style>
        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPage}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="2">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock>
        <TextBlock.Style>
         <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
          <Setter Property="Text" Value="Review the migration"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
            <Setter Property="Text" Value="Review the USB upgrade"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <TextBlock x:Name="ReviewSummary" FontWeight="SemiBold"/>
       <TextBlock x:Name="ReviewRoute" Margin="0,4,0,0" Visibility="{Binding IsUsbUpgrade, Converter={StaticResource VisibleWhenTrue}}"/>
       <Label Margin="0,14,0,0" Content="Source database"/>
       <TextBlock x:Name="ReviewDatabase"/>
       <Label Margin="0,12,0,0">
        <Label.Style>
         <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
          <Setter Property="Content" Value="Destination folder"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
            <Setter Property="Content" Value="USB folder to upgrade"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Label.Style>
       </Label>
       <TextBlock x:Name="ReviewDestination"/>
       <StackPanel Visibility="{Binding IsUsbUpgrade, Converter={StaticResource VisibleWhenTrue}}">
        <Label Margin="0,12,0,0" Content="Backup folder"/>
        <TextBlock x:Name="ReviewBackupFolder"/>
       </StackPanel>
       <Label Margin="0,12,0,0">
        <Label.Style>
         <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
          <Setter Property="Content" Value="Music to copy"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
            <Setter Property="Content" Value="Music"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Label.Style>
       </Label>
       <TextBlock x:Name="ReviewMusic"/>
       <Border Margin="0,15,0,0" Padding="14,10" Background="{StaticResource AccentLight}" CornerRadius="6">
        <StackPanel>
         <TextBlock x:Name="ReviewWarningTitle" FontWeight="SemiBold"/>
         <ItemsControl x:Name="ReviewWarnings" ItemTemplate="{StaticResource MigrationWarning}" Margin="0,6,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel AutomationProperties.Name="Result step">
       <StackPanel.Style>
        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPage}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="3">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock>
        <TextBlock.Style>
         <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
          <Setter Property="Text" Value="Migration complete"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
            <Setter Property="Text" Value="USB upgrade complete"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
       <TextBlock x:Name="ResultSummary" FontWeight="SemiBold"/>
       <Label Margin="0,14,0,0" Content="New installation"/>
       <TextBlock x:Name="ResultDestination"/>
       <Label Margin="0,12,0,0" Content="Backup ZIP"/>
       <TextBlock x:Name="ResultBackup"/>
       <Label Margin="0,12,0,0" Content="Migration report"/>
       <TextBlock x:Name="ResultReport"/>
       <TextBlock x:Name="ResultWarningTitle" Margin="0,15,0,4" FontWeight="SemiBold"/>
       <ItemsControl x:Name="ResultWarnings" ItemTemplate="{StaticResource MigrationWarning}"/>
      </StackPanel>
      <StackPanel AutomationProperties.Name="Restore 7.2.4">
       <StackPanel.Style>
        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPage}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="4">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock Style="{StaticResource PageTitle}" Text="Restore the 7.2.4 database"/>
       <TextBlock Text="Close Carillon.exe and CarillonBells.exe before restoring. Your music stays in its current folders."/>
       <Label Margin="0,18,0,0" Content="_USB installation folder" Target="{Binding ElementName=RestoreFolderButton}"/>
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="RestoreFolderInput" IsReadOnly="True" AutomationProperties.Name="USB installation folder"/>
        <Button x:Name="RestoreFolderButton" Grid.Column="1" Margin="10,0,0,0" Content="Choose _folder…"
         Click="ChooseRestoreFolderClick"/>
       </Grid>
       <TextBlock Style="{StaticResource FieldHint}" Margin="0,8,0,0"
        Text="Choose the folder that contains databases. Select the USB drive itself if databases is at its root."/>
       <Label Margin="0,15,0,0" Content="Pre-upgrade backup _ZIP" Target="{Binding ElementName=RestoreBackupInput}"/>
       <Grid IsEnabled="{Binding HasRestoreFolder}">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="RestoreBackupInput" MinHeight="42" Padding="10,5" VerticalContentAlignment="Center"
         MaxDropDownHeight="260" AutomationProperties.Name="Pre-upgrade backup ZIP" SelectionChanged="RestoreBackupChanged">
         <ComboBox.ItemTemplate>
          <DataTemplate>
           <StackPanel>
            <TextBlock Text="{Binding BackupDate, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ZipPath}" Style="{StaticResource FieldHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </DataTemplate>
         </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Margin="10,0,0,0" Content="Browse for Z_IP…" Click="BrowseRestoreBackupClick"/>
       </Grid>
       <TextBlock x:Name="RestoreBackupHint" Style="{StaticResource FieldHint}" Margin="0,8,0,0"
        Visibility="{Binding HasRestoreFolder, Converter={StaticResource VisibleWhenTrue}}"/>
       <Border x:Name="RestoreReviewPanel" Margin="0,18,0,0" Padding="14,12" Background="{StaticResource AccentLight}"
        CornerRadius="6" Visibility="{Binding HasRestorePlan, Converter={StaticResource VisibleWhenTrue}}">
        <StackPanel>
         <TextBlock Text="Ready to restore Carillon 7.2.4" FontWeight="SemiBold"/>
         <TextBlock x:Name="RestoreReviewSummary" Margin="0,5,0,0"/>
         <TextBlock Text="Database to restore" FontWeight="SemiBold" Margin="0,8,0,0"/>
         <TextBlock x:Name="RestoreReviewDatabase" Style="{StaticResource FieldHint}"/>
         <TextBlock Text="Selected backup ZIP" FontWeight="SemiBold" Margin="0,8,0,0"/>
         <TextBlock x:Name="RestoreReviewBackup" Style="{StaticResource FieldHint}"/>
         <TextBlock Margin="0,8,0,0"
          Text="Back Up and Restore saves a ZIP of the current v9 database, then replaces it with the verified 7.2.4 database."/>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel AutomationProperties.Name="Restore result">
       <StackPanel.Style>
        <Style TargetType="StackPanel" BasedOn="{StaticResource WizardPage}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="5">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <TextBlock Style="{StaticResource PageTitle}" Text="7.2.4 database restored"/>
       <TextBlock Text="The original database is back on the selected USB. Your music remains in its current folders."/>
       <Label Margin="0,16,0,0" Content="Restored database"/>
       <TextBlock x:Name="RestoredDatabasePath"/>
       <Label Margin="0,14,0,0" Content="Backup ZIP of the previous v9 database"/>
       <TextBlock x:Name="RestoreSafetyBackupPath"/>
       <Border Margin="0,18,0,0" Padding="14,12" Background="{StaticResource ActiveStep}" CornerRadius="6">
        <StackPanel>
         <TextBlock Text="Start Carillon 7.2.4" FontWeight="SemiBold"/>
         <TextBlock x:Name="RestoreLaunchInstructions" Margin="0,5,0,0"/>
         <TextBlock Margin="0,8,0,0"
          Text="Opening CarillonBells.exe will offer to upgrade the restored database again."/>
        </StackPanel>
       </Border>
      </StackPanel>
    </Grid>
   </Border>
  </ScrollViewer>
  <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
   Background="{StaticResource Surface}" Padding="24,10,24,14">
   <StackPanel>
    <CheckBox x:Name="ReviewConfirmed" Margin="0,2,0,4" VerticalContentAlignment="Center"
     IsEnabled="{Binding CanNavigate}">
     <CheckBox.Style>
      <Style TargetType="CheckBox">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentStep}" Value="2">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </CheckBox.Style>
     <TextBlock>
      <TextBlock.Style>
       <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Text" Value="I have reviewed the source database, destination, and warnings and want to create this v9 installation."/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
          <Setter Property="Text" Value="I have reviewed the USB folder, backup location, and warnings and want to upgrade this installation."/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </CheckBox>
    <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" MinHeight="21"
     Foreground="{StaticResource Muted}">
     <TextBlock.Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
       <Style.Triggers>
        <Trigger Property="Text" Value="">
         <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger>
       </Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
    <ProgressBar Height="5" Margin="0,7,0,0" IsIndeterminate="True"
     AutomationProperties.Name="Operation progress" Visibility="{Binding IsMigrating, Converter={StaticResource VisibleWhenTrue}}"/>
    <Grid Margin="0,10,0,0">
     <Button HorizontalAlignment="Left" Content="_Close" Click="CloseClick">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsMigrating}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <Button HorizontalAlignment="Left" Click="CancelMigrationClick"
      IsEnabled="{Binding CanCancelMigration}" Visibility="{Binding IsMigrating, Converter={StaticResource VisibleWhenTrue}}">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Content" Value="_Cancel migration"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
          <Setter Property="Content" Value="_Cancel upgrade"/>
         </DataTrigger>
         <DataTrigger Binding="{Binding CurrentStep}" Value="4">
          <Setter Property="Content" Value="_Cancel restore"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <StackPanel Orientation="Horizontal">
       <StackPanel.Style>
        <Style TargetType="StackPanel">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="3">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </StackPanel.Style>
       <Button Click="OpenDestinationClick" Margin="0,0,10,0">
        <Button.Style>
         <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Content" Value="Open _destination folder"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsUsbUpgrade}" Value="True">
            <Setter Property="Content" Value="Open _USB folder"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Button.Style>
       </Button>
       <Button Content="Open v9 for _review" Style="{StaticResource PrimaryButton}" Click="OpenReviewClick"/>
      </StackPanel>
      <Button Margin="0,0,10,0" Content="_Back" Click="BackClick">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
         <Setter Property="IsEnabled" Value="{Binding CanNavigate}"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="0">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding CurrentStep}" Value="3">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding CurrentStep}" Value="5">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
      <Button Click="AdvanceClick">
       <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
         <Setter Property="IsDefault" Value="True"/>
         <Setter Property="IsEnabled" Value="{Binding CanNavigate}"/>
         <Setter Property="Content" Value="_Next"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding CurrentStep}" Value="2">
           <Setter Property="Content" Value="Back Up and _Migrate"/>
          </DataTrigger>
          <MultiDataTrigger>
           <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding CurrentStep}" Value="2"/>
            <Condition Binding="{Binding IsUsbUpgrade}" Value="True"/>
           </MultiDataTrigger.Conditions>
           <Setter Property="Content" Value="Back Up and _Upgrade"/>
          </MultiDataTrigger>
          <MultiDataTrigger>
           <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding CurrentStep}" Value="2"/>
            <Condition Binding="{Binding IsChecked, ElementName=ReviewConfirmed}" Value="False"/>
           </MultiDataTrigger.Conditions>
           <Setter Property="IsEnabled" Value="False"/>
          </MultiDataTrigger>
          <DataTrigger Binding="{Binding CurrentStep}" Value="3">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding CurrentStep}" Value="4">
           <Setter Property="Content" Value="_Review restore"/>
          </DataTrigger>
          <MultiDataTrigger>
           <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding CurrentStep}" Value="4"/>
            <Condition Binding="{Binding RestoreBackupSelected}" Value="False"/>
           </MultiDataTrigger.Conditions>
           <Setter Property="IsEnabled" Value="False"/>
          </MultiDataTrigger>
          <DataTrigger Binding="{Binding HasRestorePlan}" Value="True">
           <Setter Property="Content" Value="Back Up and _Restore"/>
           <Setter Property="IsDefault" Value="False"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding CurrentStep}" Value="5">
           <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Button.Style>
      </Button>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
