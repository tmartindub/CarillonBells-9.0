<Application x:Class="Carillon.Migration.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MigrationWindow.xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#173650"/>
  <SolidColorBrush x:Key="Muted" Color="#526678"/>
  <SolidColorBrush x:Key="Canvas" Color="#EFF3F6"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Line" Color="#D5E0E8"/>
  <SolidColorBrush x:Key="ActiveStep" Color="#E3EDF5"/>
  <SolidColorBrush x:Key="Accent" Color="#B04E18"/>
  <SolidColorBrush x:Key="AccentHover" Color="#943D12"/>
  <SolidColorBrush x:Key="AccentLight" Color="#F9E7D8"/>
  <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style TargetType="Label">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="0,0,0,6"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="MinHeight" Value="38"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Padding" Value="14,7"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Accent}"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource Ink}"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
   <Setter Property="Foreground" Value="White"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{StaticResource AccentHover}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StepText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="10,9"/>
   <Setter Property="TextAlignment" Value="Center"/>
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="FontFamily" Value="Georgia"/>
   <Setter Property="FontSize" Value="25"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="WizardPage" TargetType="StackPanel">
   <Setter Property="Visibility" Value="Collapsed"/>
  </Style>
  <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="14"/>
  </Style>
  <DataTemplate x:Key="MigrationWarning">
   <Grid Margin="0,0,0,6">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="18"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <TextBlock Text="•" Foreground="{StaticResource Accent}"/>
    <TextBlock Grid.Column="1" Text="{Binding}"/>
   </Grid>
  </DataTemplate>
 </Application.Resources>
</Application>
