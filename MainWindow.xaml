<Window Language="en-US" x:Class="Carillon.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Carillon Bells 9.0" Width="1280" Height="800" WindowState="Maximized"
 MinWidth="1200" MinHeight="740" WindowStartupLocation="CenterScreen"
 Closing="WindowClosing" Icon="images and icons/Carillon.ico" Background="{DynamicResource Canvas}" FontFamily="Bahnschrift" FontSize="18">
 <Window.Resources>
  <CollectionViewSource x:Key="SongGroups" Source="{Binding Songs}">
   <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions>
  </CollectionViewSource>
 </Window.Resources>
 <DockPanel><Menu DockPanel.Dock="Top"><MenuItem Header="_File"><MenuItem Header="E_xit" Click="ExitClick"/></MenuItem></Menu>
 <Grid Background="{DynamicResource Canvas}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#15354F">
   <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
    <StackPanel>
     <Border Width="26" Height="26" Background="#D87732" CornerRadius="7" HorizontalAlignment="Left" Margin="0,0,0,4"><TextBlock Text="C" Foreground="White" FontFamily="Georgia" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <TextBlock Text="CARILLON" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="BELLS &amp; CHIMES" Foreground="#AFC4D6" FontSize="14" Margin="0,2,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="Playlist" Foreground="White" FontSize="19" Margin="8,0,0,4"/>
      <Button Content="Today's schedule" Click="ScheduleClick" Background="Transparent" Foreground="#C8D8E5" BorderThickness="0" Margin="0,2" Padding="3,3"/>
      <Separator Background="#36556D" Margin="0,3"/>
      <Button Content="Silence windows" Tag="Silence" Click="AdminClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Music groups" Tag="Groups" Click="AdminClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Random music" Tag="Random" Click="AdminClick" Margin="0,1" Padding="6,3"/>
      <Button Content="System" Tag="System" Click="AdminClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Email / reports" Tag="Email" Click="AdminClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Clock" Click="ClockClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Log" Click="LogClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Themes" Tag="Themes" Click="AdminClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Database import" Tag="Database" Click="AdminClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Help" Click="HelpClick" Margin="0,1" Padding="6,3"/>
      <Button Content="Exit" Click="ExitClick" Margin="0,1" Padding="6,3"/>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="{Binding Organization}" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxHeight="51" TextTrimming="CharacterEllipsis"/><TextBlock Text="Carillon Bells / 9.0" Foreground="#91AEC4" FontSize="14" Margin="0,4,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="16,10">
   <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="96"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Westminster Chimes &amp; Carillon Bells" FontFamily="Georgia" FontSize="30" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding TodayLabel}" Foreground="{DynamicResource Muted}" FontSize="16" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="12,0,0,0">
     <Button Content="Themes" Tag="Themes" Click="AdminClick" Margin="0,0,14,0"/>
     <Border Background="{DynamicResource Surface}" CornerRadius="20" Padding="14,10">
      <CheckBox x:Name="ScheduleToggle" Content="Schedule enabled" IsChecked="True" Click="ToggleSchedule"/>
     </Border>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,0,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,12,0"><StackPanel><TextBlock Text="NEXT SONG" FontSize="14" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding NextSongLabel}" FontSize="18" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,12,0"><StackPanel><TextBlock Text="TODAY'S SCHEDULE" FontSize="14" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding ScheduleCountLabel}" FontSize="18" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,8"><StackPanel><TextBlock Text="SILENCE WINDOW" FontSize="14" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding SilenceLabel}" FontSize="18" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="10">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="Your music" FontFamily="Georgia" FontSize="28"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Expand" Click="ExpandClick" Padding="10,6" Margin="0,0,6,12"/><Button Content="Collapse" Click="CollapseClick" Padding="10,6" Margin="0,0,0,12"/></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="0,0,0,8">
       <TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Search song titles or groups" AutomationProperties.Name="Search music"/>
       <TextBlock Text="Search songs or groups..." IsHitTestVisible="False" Foreground="{DynamicResource Muted}" Margin="10,0" VerticalAlignment="Center" FontSize="16">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <DataGrid Grid.Row="2" x:Name="SongGrid" ItemsSource="{Binding Source={StaticResource SongGroups}}" SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" IsReadOnly="True"
       HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource Surface}"
       SelectionMode="Single" SelectionUnit="FullRow" IsSynchronizedWithCurrentItem="False" RowHeight="44" FontSize="18" EnableRowVirtualization="False"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <DataGrid.RowStyle><Style TargetType="DataGridRow"><EventSetter Event="MouseDoubleClick" Handler="SongDoubleClick"/></Style></DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTextColumn Header="SONG NAME" Binding="{Binding Title}" Width="*"/>
        <DataGridTextColumn Header="LENGTH" Binding="{Binding Duration}" Width="100"/>
       </DataGrid.Columns>
       <DataGrid.GroupStyle>
        <GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value>
         <ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Margin="0,2">
          <Expander.Header><StackPanel Orientation="Horizontal" Margin="3,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ItemCount, StringFormat='  /  {0} songs'}" Foreground="{DynamicResource Muted}" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{Binding Items,Converter={StaticResource GroupDuration}}" FontSize="15" VerticalAlignment="Center"/></StackPanel></Expander.Header>
          <ItemsPresenter/>
         </Expander></ControlTemplate>
        </Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle>
       </DataGrid.GroupStyle>
      </DataGrid>
      <StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="Add files" Click="AddClick" Padding="9,4"/><Button Content="Delete" Click="DeleteClick" Padding="9,4" Margin="5,0"/><TextBlock Text="{Binding LibraryLabel}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
     </Grid>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10" PreviewGotKeyboardFocus="BeginEdit">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="404">
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="46"/><RowDefinition Height="62"/><RowDefinition Height="62"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Play schedule" FontFamily="Georgia" FontSize="28"/><TextBlock Text="{Binding SelectedSong.Title}" Foreground="{DynamicResource Muted}" FontSize="16" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="PLAY ON THESE DAYS" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,2,0,6"/>
       <ItemsControl ItemsSource="{Binding EditingSong.Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled,Mode=TwoWay}" FontSize="16"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="FROM" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,2,0,4"/><DatePicker Padding="2" SelectedDate="{Binding EditingSong.From,Mode=TwoWay}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="UNTIL" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,2,0,4"/><DatePicker Padding="2" SelectedDate="{Binding EditingSong.To,Mode=TwoWay}"/></StackPanel>
      </Grid>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="GROUP" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,2,0,4"/><TextBox Text="{Binding EditingSong.Group,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="38"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="TIMES TO PLAY" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,2,0,4"/><TextBox Text="{Binding EditingSong.Repeats,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="38"/></StackPanel>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,2,0,2">
       <TextBlock Text="PLAY TIMES  /  UP TO 12 EACH DAY" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,0,0,4"/>
       <ItemsControl ItemsSource="{Binding EditingSong.Times}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,4" Padding="6,3" FontSize="16" Height="32" AutomationProperties.Name="Scheduled play time"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <Grid Grid.Row="5"><StackPanel Orientation="Horizontal">
       <Button Content="|&lt;" Tag="First" Click="NavigateClick" Padding="8,7" ToolTip="First song"/><Button Content="&lt;" Tag="Prior" Click="NavigateClick" Padding="10,7" Margin="4,0" ToolTip="Previous song"/>
       <Button Content="&gt;" Tag="Next" Click="NavigateClick" Padding="10,7" ToolTip="Next song"/><Button Content="&gt;|" Tag="Last" Click="NavigateClick" Padding="8,7" Margin="4,0" ToolTip="Last song"/>
      </StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelClick" Margin="0,0,7,0"/><Button Content="Save" Style="{StaticResource Primary}" Click="SaveClick"/></StackPanel></Grid>
     </Grid></ScrollViewer>
    </Border>
   </Grid>
   <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,4" Padding="12,8">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="PLAYER" FontSize="14" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding PlayerTitle}" Margin="0,3,15,0" FontSize="19" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PlaybackLabel}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,25,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="Play" Click="PlayClick" Style="{StaticResource Primary}" Padding="18,7"/><Button Content="Pause" Click="PauseClick" Padding="13,7" Margin="7,0"/><Button Content="Stop" Click="StopClick" Padding="13,7"/>
     </StackPanel><ProgressBar x:Name="PlayerProgress" Maximum="3" Height="4" Margin="0,12,0,0" Foreground="#D87732" Background="#E7EDF1" BorderThickness="0"/></StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="SYSTEM VOLUME" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="35" ValueChanged="VolumeChanged" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="1" x:Name="MuteButton" Content="Mute" Click="MuteClick" Padding="12,6"/></Grid></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,10,0" Text="{Binding Status}" FontSize="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Footer}" FontSize="14" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  </Grid>
  <Border Grid.Column="1" Background="#D9173650" Visibility="{Binding ScheduleVisible,Converter={StaticResource BoolVisibility}}">
   <Border Style="{StaticResource Card}" Width="780" MaxHeight="780" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
    <Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition/><RowDefinition Height="55"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Today's schedule" FontFamily="Georgia" FontSize="30"/><TextBlock Text="Full day and remaining events; silence exclusions applied." Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding ScheduleRows}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" FontFamily="Bahnschrift" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,8" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Button Grid.Row="2" Content="Back to playlist" Click="ScheduleClick" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
   </Border>
  </Border>
 </Grid>
 </DockPanel>
</Window>
