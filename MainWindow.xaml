<Window Language="en-US" x:Class="Carillon.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Carillon Bells 9.0" Width="1280" Height="760" WindowState="Maximized"
 MinWidth="1000" MinHeight="660" WindowStartupLocation="CenterScreen"
 Closing="WindowClosing" Icon="images and icons/Carillon.ico" Background="{DynamicResource Canvas}" FontFamily="Bahnschrift" FontSize="18">
 <Window.Resources>
  <CollectionViewSource x:Key="SongGroups" Source="{Binding Songs}">
   <CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions>
  </CollectionViewSource>
 </Window.Resources>
 <DockPanel><Menu DockPanel.Dock="Top"><MenuItem Header="_File"><MenuItem Header="E_xit" Click="ExitClick"/></MenuItem></Menu><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Grid Width="1440" Height="1000" Background="{DynamicResource Canvas}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#15354F">
   <Grid Margin="19,28">
    <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
    <StackPanel>
     <Border Width="38" Height="38" Background="#D87732" CornerRadius="11" HorizontalAlignment="Left" Margin="0,0,0,14">
      <TextBlock Text="C" Foreground="White" FontFamily="Georgia" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="CARILLON" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="BELLS &amp; CHIMES" Foreground="#AFC4D6" FontSize="14" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,0">
     <TextBlock Text="WORKSPACE" Foreground="#91AEC4" FontSize="14" Margin="9,0,0,12"/>
     <Border Background="#2C526E" CornerRadius="7" Padding="13,12"><TextBlock Text="Playlist" Foreground="White" FontSize="19"/></Border>
     <Button Content="Today's schedule" Click="ScheduleClick" Background="Transparent" Foreground="#C8D8E5" BorderThickness="0" Margin="0,8,0,0" Padding="5,12"/>
     <Separator Background="#36556D" Margin="0,14"/>
     <TextBlock Text="OTHER PAGES" Foreground="#91AEC4" FontSize="14" Margin="9,0,0,7"/>
     <Button Content="Silence windows" Tag="Silence" Click="AdminClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Music groups" Tag="Groups" Click="AdminClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Random music" Tag="Random" Click="AdminClick" Margin="0,2" Padding="6,5"/>
     <Button Content="System" Tag="System" Click="AdminClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Email / reports" Tag="Email" Click="AdminClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Clock" Click="ClockClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Log" Click="LogClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Themes" Tag="Themes" Click="AdminClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Database import" Tag="Database" Click="AdminClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Help" Click="HelpClick" Margin="0,2" Padding="6,5"/>
     <Button Content="Exit" Click="ExitClick" Margin="0,2" Padding="6,5"/>    </StackPanel>
    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
     <Border Background="#24455F" CornerRadius="7" Padding="12">
      <StackPanel><TextBlock Text="PORTABLE WORKSPACE" Foreground="#F1BA88" FontSize="14"/><TextBlock Text="{Binding Organization}" Foreground="White" FontSize="15" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="SQLite database" Foreground="#AFC4D6" FontSize="15" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <TextBlock Text="Carillon Bells / 9.0" Foreground="#91AEC4" FontSize="14" Margin="2,16,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,28,14">
   <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="140"/><RowDefinition Height="36"/></Grid.RowDefinitions>
   <Grid>
    <StackPanel>
     <TextBlock Text="WESTMINSTER CHIMES AND CARILLON BELLS 9.0" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,2,0,7"/>
     <TextBlock Text="Westminster Chimes &amp; Carillon Bells" FontFamily="Georgia" FontSize="30"/>
     <TextBlock Text="{Binding TodayLabel}" Foreground="{DynamicResource Muted}" FontSize="16" Margin="0,7,0,0"/>
    </StackPanel>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
     <Button Content="Themes" Tag="Themes" Click="AdminClick" Margin="0,0,14,0"/>
     <Border Background="{DynamicResource Surface}" CornerRadius="20" Padding="14,10">
      <CheckBox x:Name="ScheduleToggle" Content="Schedule enabled" IsChecked="True" Click="ToggleSchedule"/>
     </Border>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="0,9,0,17">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="16,11" Margin="0,0,12,0"><StackPanel><TextBlock Text="NEXT SONG" FontSize="14" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding NextSongLabel}" FontSize="18" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,11" Margin="0,0,12,0"><StackPanel><TextBlock Text="TODAY'S SCHEDULE" FontSize="14" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding ScheduleCountLabel}" FontSize="18" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,11"><StackPanel><TextBlock Text="SILENCE WINDOW" FontSize="14" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding SilenceLabel}" FontSize="18" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="56"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="Your music" FontFamily="Georgia" FontSize="28"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Expand" Click="ExpandClick" Padding="10,6" Margin="0,0,6,12"/><Button Content="Collapse" Click="CollapseClick" Padding="10,6" Margin="0,0,0,12"/></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="0,0,0,13">
       <TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="Search song titles or groups" AutomationProperties.Name="Search music"/>
       <TextBlock Text="Search songs or groups..." IsHitTestVisible="False" Foreground="{DynamicResource Muted}" Margin="10,0" VerticalAlignment="Center" FontSize="16">
        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <DataGrid Grid.Row="2" x:Name="SongGrid" ItemsSource="{Binding Source={StaticResource SongGroups}}" SelectedItem="{Binding SelectedSong, Mode=TwoWay}"
       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" IsReadOnly="True"
       HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource Surface}"
       SelectionMode="Single" SelectionUnit="FullRow" IsSynchronizedWithCurrentItem="False" RowHeight="44" FontSize="18" EnableRowVirtualization="False"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <DataGrid.RowStyle><Style TargetType="DataGridRow"><EventSetter Event="MouseDoubleClick" Handler="SongDoubleClick"/></Style></DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTextColumn Header="SONG NAME" Binding="{Binding Title}" Width="*"/>
        <DataGridTextColumn Header="LENGTH" Binding="{Binding Duration}" Width="100"/>
       </DataGrid.Columns>
       <DataGrid.GroupStyle>
        <GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value>
         <ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Margin="0,2">
          <Expander.Header><StackPanel Orientation="Horizontal" Margin="3,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ItemCount, StringFormat='  /  {0} songs'}" Foreground="{DynamicResource Muted}" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="{Binding Items,Converter={StaticResource GroupDuration}}" FontSize="15" VerticalAlignment="Center"/></StackPanel></Expander.Header>
          <ItemsPresenter/>
         </Expander></ControlTemplate>
        </Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle>
       </DataGrid.GroupStyle>
      </DataGrid>
      <StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="Add files" Click="AddClick" Padding="9,4"/><Button Content="Delete" Click="DeleteClick" Padding="9,4" Margin="5,0"/><TextBlock Text="{Binding LibraryLabel}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
     </Grid>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" PreviewGotKeyboardFocus="BeginEdit">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="76"/><RowDefinition Height="84"/><RowDefinition Height="78"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Play schedule" FontFamily="Georgia" FontSize="28"/><TextBlock Text="{Binding SelectedSong.Title}" Foreground="{DynamicResource Muted}" FontSize="16" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Row="1"><TextBlock Text="PLAY ON THESE DAYS" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,7,0,12"/>
       <ItemsControl ItemsSource="{Binding EditingSong.Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled,Mode=TwoWay}" FontSize="16"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="FROM" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,4,0,8"/><DatePicker SelectedDate="{Binding EditingSong.From,Mode=TwoWay}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="UNTIL" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,4,0,8"/><DatePicker SelectedDate="{Binding EditingSong.To,Mode=TwoWay}"/></StackPanel>
      </Grid>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="GROUP" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,4,0,8"/><TextBox Text="{Binding EditingSong.Group,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="42"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="TIMES TO PLAY" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,4,0,8"/><TextBox Text="{Binding EditingSong.Repeats,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Height="42"/></StackPanel>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,12,0,8">
       <TextBlock Text="PLAY TIMES  /  UP TO 12 EACH DAY" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,0,0,9"/>
       <ItemsControl ItemsSource="{Binding EditingSong.Times}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6" Padding="7,5" FontSize="16" Height="38" AutomationProperties.Name="Scheduled play time"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <Grid Grid.Row="5"><StackPanel Orientation="Horizontal">
       <Button Content="|&lt;" Tag="First" Click="NavigateClick" Padding="8,7" ToolTip="First song"/><Button Content="&lt;" Tag="Prior" Click="NavigateClick" Padding="10,7" Margin="4,0" ToolTip="Previous song"/>
       <Button Content="&gt;" Tag="Next" Click="NavigateClick" Padding="10,7" ToolTip="Next song"/><Button Content="&gt;|" Tag="Last" Click="NavigateClick" Padding="8,7" Margin="4,0" ToolTip="Last song"/>
      </StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="CancelClick" Margin="0,0,7,0"/><Button Content="Save" Style="{StaticResource Primary}" Click="SaveClick"/></StackPanel></Grid>
     </Grid>
    </Border>
   </Grid>
   <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,9" Padding="20,15">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="PLAYER" FontSize="14" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding PlayerTitle}" Margin="0,7,15,0" FontSize="19" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PlaybackLabel}" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,25,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="Play" Click="PlayClick" Style="{StaticResource Primary}" Padding="18,7"/><Button Content="Pause" Click="PauseClick" Padding="13,7" Margin="7,0"/><Button Content="Stop" Click="StopClick" Padding="13,7"/>
     </StackPanel><ProgressBar x:Name="PlayerProgress" Maximum="3" Height="4" Margin="0,12,0,0" Foreground="#D87732" Background="#E7EDF1" BorderThickness="0"/></StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="SYSTEM VOLUME" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="35" ValueChanged="VolumeChanged" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="1" x:Name="MuteButton" Content="Mute" Click="MuteClick" Padding="12,6"/></Grid></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="4"><TextBlock Text="{Binding Status}" FontSize="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><TextBlock Text="{Binding Footer}" FontSize="14" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
  </Grid>
  <Border Grid.Column="1" Background="#D9173650" Visibility="{Binding ScheduleVisible,Converter={StaticResource BoolVisibility}}">
   <Border Style="{StaticResource Card}" Width="780" MaxHeight="780" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
    <Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition/><RowDefinition Height="55"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Today's schedule" FontFamily="Georgia" FontSize="30"/><TextBlock Text="Full day and remaining events; silence exclusions applied." Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding ScheduleRows}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Ink}" FontFamily="Bahnschrift" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,8" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Button Grid.Row="2" Content="Back to playlist" Click="ScheduleClick" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
   </Border>
  </Border>
 </Grid>
 </ScrollViewer></DockPanel>
</Window>
