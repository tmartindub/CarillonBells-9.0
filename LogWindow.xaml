<Window x:Class="Carillon.LogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Carillon Log" Width="1000" Height="640" Background="{DynamicResource Canvas}" WindowStartupLocation="CenterOwner" Icon="images and icons/Carillon.ico">
 <DockPanel Margin="20"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15"><Button Content="Refresh" Click="RefreshClick"/><Button Content="Close" Click="CloseClick" Margin="10,0"/><TextBlock Text="Latest 1,000 entries · newest first" VerticalAlignment="Center"/></StackPanel>
 <DataGrid x:Name="Entries" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"><DataGrid.Columns><DataGridTextColumn Header="Date / Time" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180"/><DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="*"/></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
