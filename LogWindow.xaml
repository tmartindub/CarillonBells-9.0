<Window FontSize="{DynamicResource UiFontSize18}" FontFamily="{DynamicResource BodyFontFamily}" Language="en-US" x:Class="Carillon.LogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Westminster Chimes and Carillon Bells v9.0 - Log" Width="1200" Height="720" Background="{DynamicResource Canvas}" WindowStartupLocation="CenterOwner" Icon="images and icons/Carillon-Bells-9.0-icon.ico">
 <DockPanel Margin="20"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15"><Button Content="Refresh" Click="RefreshClick"/><Button Content="Close" Click="CloseClick" Margin="10,0"/><TextBlock Text="Latest 1,000 entries · newest first" VerticalAlignment="Center"/></StackPanel>
 <DataGrid x:Name="Entries" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="NaN" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"><DataGrid.Columns><DataGridTextColumn Header="Date / Time" Binding="{Binding Timestamp, StringFormat=MM/dd/yyyy HH:mm:ss}" Width="240"/><DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
