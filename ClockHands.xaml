 <!-- Each drawing uses a 460 by 460 tile centered at 230,230 with the hand facing twelve. -->
 <SolidColorBrush x:Key="ClockHandInk" Color="#16354E"/>
 <SolidColorBrush x:Key="ClockHandFacet" Color="#45677F"/>
 <DrawingBrush x:Key="ClockHandCap" Viewbox="0,0,460,460" ViewboxUnits="Absolute" Stretch="Fill">
  <DrawingBrush.Drawing>
   <DrawingGroup>
    <DrawingGroup.Children>
     <GeometryDrawing Brush="{StaticResource ClockHandInk}">
      <GeometryDrawing.Geometry><EllipseGeometry Center="230,230" RadiusX="16.71" RadiusY="16.71"/></GeometryDrawing.Geometry>
     </GeometryDrawing>
     <GeometryDrawing Brush="#B8CAD7">
      <GeometryDrawing.Geometry><EllipseGeometry Center="230,230" RadiusX="6.18" RadiusY="6.18"/></GeometryDrawing.Geometry>
     </GeometryDrawing>
    </DrawingGroup.Children>
   </DrawingGroup>
  </DrawingBrush.Drawing>
 </DrawingBrush>

 <LinearGradientBrush x:Key="ClockHandBurnishedBronze" StartPoint="0,0.42" EndPoint="1,0.58">
  <GradientStop Offset="0" Color="#4A2418"/><GradientStop Offset="0.40" Color="#824C26"/>
  <GradientStop Offset="0.65" Color="#9B5E31"/><GradientStop Offset="1" Color="#572D1B"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="ClockHandOldCopper" StartPoint="0,0.42" EndPoint="1,0.58">
