  <GradientStop Offset="0.67" Color="#A95B39"/><GradientStop Offset="1" Color="#673321"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="ClockHandAntiqueBrass" StartPoint="0,0.42" EndPoint="1,0.58">
